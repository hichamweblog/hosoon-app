# Optional. Without these, the application stays local/guest only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server ONLY; never prefix this with NEXT_PUBLIC_. Required only for account deletion.
# SUPABASE_SERVICE_ROLE_KEY=

# Local Supabase behind a preview-safe, same-origin proxy (optional):
# NEXT_PUBLIC_SUPABASE_URL=/supabase
# SUPABASE_INTERNAL_URL=http://127.0.0.1:54321
# APP_ORIGIN=https://your-exact-preview-host.e2b.app
# Set Supabase Auth redirect URLs to the exact app origin + /auth/recovery, not a wildcard.

# Change at every deployment so the precached generic HTML is versioned.
APP_RELEASE_VERSION=0.2.0-v4
NEXT_TELEMETRY_DISABLED=1
